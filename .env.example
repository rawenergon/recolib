# ============================================================
# RECO LABS - Library Ecosystem | Example Environment File
# ------------------------------------------------------------
# 1. Copy this file and rename it to:  .env.local
# 2. Fill in the values below with your own credentials.
#    NEVER commit the real .env.local to git.
#
# NOTE: Vite only exposes variables prefixed with VITE_ to the
# browser. Everything else stays server-side only.
# ============================================================

# --- Google Gemini API Key (optional, used for future AI features) ---
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase Project Config ---
# Project URL: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (anon) key - safe to expose in the browser.
# Supabase Dashboard -> Project Settings -> API -> Project API keys
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here